{
  "name": "placement-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Campus placement portal: students, company HR and the placement cell on one MySQL database",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "demo-passwords": "node --env-file=.env scripts/set-demo-passwords.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "ejs": "^3.1.10",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "mysql2": "^3.24.6"
  }
}
